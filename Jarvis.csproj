<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 19041 нужен ради Windows.Media.Ocr: распознавание текста экрана встроено в Windows и работает офлайн -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms подключён только ради иконки в трее -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jarvis</AssemblyName>
    <RootNamespace>Jarvis</RootNamespace>
    <!-- Иконка exe, панели задач и Alt+Tab: Windows берёт её из Win32-ресурса, кода на это не нужно -->
    <ApplicationIcon>assets\jarvis.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- WPF-нативные dll иначе остаются россыпью рядом с exe и single-file падает с DllNotFoundException -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="com.github.csukuangfj.piper.phonemize" Version="1.5.9" />
    <PackageReference Include="com.github.csukuangfj.piper.phonemize.runtime.win-x64" Version="1.5.9" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
    <PackageReference Include="NAudio.WinMM" Version="2.4.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="2.0.1" />
    <PackageReference Include="System.Speech" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <!-- глобальные using WinForms сделали бы TextBox/Color неоднозначными во всех WPF-файлах -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native\**\*.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- Та же эмблема, что и в ICO, но одним маленьким кадром: из неё трей рисует свои значки. -->
    <EmbeddedResource Include="assets\jarvis.png" />
  </ItemGroup>

</Project>
